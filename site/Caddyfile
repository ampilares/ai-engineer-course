# Replace learn.example.com with your domain. Caddy fetches and renews TLS certs
# automatically. For a first local test you can use ":80" instead of a domain.
learn.example.com {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
