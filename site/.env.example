# Copy to .env and fill in. All are optional for local dev (magic links print to the
# server console and appear on-screen). Set them for production on your VPS.

# Public base URL of the site (used to build magic-link URLs in emails).
BASE_URL=https://learn.example.com

# Where the SQLite database file lives. Defaults to ./data if unset.
DATA_DIR=/data

# --- Email (SMTP). If SMTP_HOST is unset, the app runs in "dev mail" mode and shows
# the sign-in link on screen instead of emailing it. Set these in production. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# MAIL_FROM=Practical AI Engineer <no-reply@example.com>
